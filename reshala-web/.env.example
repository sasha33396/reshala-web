# Backend runtime
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=3001

# Paths inside backend container
FLEET_DB_PATH=/app/fleet_db
SSH_KEYS_DIR=/app/ssh_keys
PLUGINS_DIR=/app/plugins
DATA_DIR=/app/data
PROMETHEUS_URL=http://prometheus:9090

# Host paths mounted by docker-compose
FLEET_DB_HOST_PATH=/root/.reshala_fleet
SSH_KEYS_HOST_PATH=/root/.ssh
PLUGINS_HOST_PATH=./plugins

# Auth
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=24h
ADMIN_PASSWORD_HASH=$2b$10$replace_with_bcrypt_hash

# SOCKS5 proxy (optional, for routing SSH through proxy)
# SOCKS5_HOST=your.proxy.host
# SOCKS5_PORT=1080
# SOCKS5_USER=your_user
# SOCKS5_PASS=your_pass

# Remnawave panel API (optional)
# REMNAWAVE_URL=https://panel.example.com
# REMNAWAVE_API_KEY=replace-with-api-key

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/

# Server-side Next.js rewrite target.
# In docker-compose it should point to backend service.
API_PROXY_TARGET=http://backend:3001/api
